# 复制为 .env 后填写。任意 OpenAI 兼容的 /chat/completions 接口均可，需支持 function calling。
# 使用 --mock 离线模式时无需配置。

# 示例一：DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 示例二：通义千问（DashScope 兼容模式）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 示例三：OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 可选
LLM_TEMPERATURE=0
LLM_TIMEOUT=60
